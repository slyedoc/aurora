#version 460
#extension GL_EXT_buffer_reference2 : enable
#extension GL_EXT_ray_tracing : enable
#extension GL_EXT_nonuniform_qualifier : enable

#include "types.glsl"
#include "rand.glsl"
#include "common.glsl"
#include "disney.glsl"

layout(set=0, binding=0, rgba32f) uniform restrict image2D render_target;
// DLSS Ray Reconstruction guides, render resolution, written for the primary hit of sample 0
// when uniforms.dlss != 0 (partially bound otherwise).
layout(set=0, binding=1, rgba16f) uniform restrict writeonly image2D guide_normal_roughness;
layout(set=0, binding=2, rgba8)   uniform restrict writeonly image2D guide_diffuse;
layout(set=0, binding=3, rgba8)   uniform restrict writeonly image2D guide_specular;
layout(set=0, binding=4, r32f)    uniform restrict writeonly image2D guide_depth;
layout(set=0, binding=5, r32f)    uniform restrict writeonly image2D guide_spec_hit;
layout(set=0, binding=6, rg16f)   uniform restrict writeonly image2D guide_motion;
layout(set=0, binding=7, rgba16f) uniform restrict writeonly image2D dlss_color;
layout(set=0, binding=100)        uniform accelerationStructureEXT topLevelAS;
layout(set=1, binding=200)        uniform sampler2D textures[];

layout(push_constant, std430) uniform Registers {
  PushConstants pc;
};

layout(location = 0) rayPayloadEXT HitPayload payload;

const bool ENABLE_BLUENOISE = true;
// Paths per pixel and their maximum length come from the uniforms (`pc.uniforms.samples`
// / `max_bounces`); the DLSS path runs 1 spp with a short cap.

const float g_extinction = 0.03;

float sampleDistanceInFog() {
  return -log(randf()) / pc.uniforms.foginess;
}

float calcFogTransmittance(float distance) {
  return exp(-g_extinction * distance);
}

vec3 sampleFogScatterDirection(vec3 incoming) {
  // Henyey-Greenstein phase function sampling
  // g is the asymmetry parameter (-1 <= g <= 1)
  // g > 0 means forward scattering
  // g < 0 means backward scattering
  // g = 0 means isotropic scattering

  const float g = pc.uniforms.fog_scatter;
  float cosTheta;
  if (g == 0.0) {
    // isotropic
    cosTheta = 1.0 - 2.0 * randf();
  } else {
    // anisotropic
    float term = (1.0 - g * g) / (1.0 + g * (2.0 * randf() - 1.0));
    cosTheta = (1.0 + g * g - term * term) / (2.0 * g);
  }

  float sinTheta = sqrt(max(0.0, 1.0 - cosTheta * cosTheta));
  float phi = 2.0 * PI * randf();

  vec3 ret = vec3(sinTheta * cos(phi), sinTheta * sin(phi), cosTheta);
  return orthonormalBasis(incoming) * ret;
}

// Extracts either the first two or second two bytes from the uint
// encoded byte buffer. As a result, byteIndex must be an even number
// for this to work.
vec2 TwoBnoiseSamples(const uint byteIndex) {
  const uint uintIndex = byteIndex / 4;
  const uint packedUInt = pc.bluenoise.bluenoise[uintIndex];

  // Calculate the shift amount based on the byte index modulo 4
  const uint shiftAmount = (byteIndex % 4) * 8;

  // Extract the two bytes at positions byteIndex and byteIndex+1 (next byte)
  uvec2 res = uvec2((packedUInt >> shiftAmount), (packedUInt >> (shiftAmount + 8)));

  return vec2((res.x & 0xFF) / 255.0, (res.y & 0xFF) / 255.0);
}

// Assumed to be called once per sample
vec2 bnoiseBest(const uint sampleIdx) {
  // 64 bluenoise slices; the seed advances every frame under DLSS (and per accumulation tick).
  const uint textureIdx = ((pc.uniforms.dlss != 0 ? pc.uniforms.frame : pc.uniforms.tick) * pc.uniforms.samples + sampleIdx) % 64;
  if (textureIdx >= 64) { return vec2(randf(), randf()); }
  const uint x = gl_LaunchIDEXT.x % 128;
  const uint y = gl_LaunchIDEXT.y % 128;
  uint byteIndex = 128 * 128 * 2 * textureIdx + 128 * 2 * y + 2 * x;
  return TwoBnoiseSamples(byteIndex);
}

// The world-space corners of triangle `tri` of light instance `li`, through the live
// TLAS instance row (3x4 row-major, as in prev_instances); `g` gets the geometry index.
void lightTriangleWorld(LightInstance li, const uint tri, out uint g, out vec3 w0, out vec3 w1, out vec3 w2) {
  g = 0u;
  for (uint k = 1u; k < li.geom_count; k++) {
    if (li.geom_to_triangle.index_offsets[k] <= tri) { g = k; } else { break; }
  }
  const uint idx = li.geom_to_index.index_offsets[g] + (tri - li.geom_to_triangle.index_offsets[g]) * 3u;
  const vec3 p0 = li.vertices.data[li.indices.data[idx + 0u]].position;
  const vec3 p1 = li.vertices.data[li.indices.data[idx + 1u]].position;
  const vec3 p2 = li.vertices.data[li.indices.data[idx + 2u]].position;
  const uint base = li.slot * 4u;
  const vec4 r0 = pc.cur_instances.data[base + 0u];
  const vec4 r1 = pc.cur_instances.data[base + 1u];
  const vec4 r2 = pc.cur_instances.data[base + 2u];
  w0 = vec3(dot(r0, vec4(p0, 1.0)), dot(r1, vec4(p0, 1.0)), dot(r2, vec4(p0, 1.0)));
  w1 = vec3(dot(r0, vec4(p1, 1.0)), dot(r1, vec4(p1, 1.0)), dot(r2, vec4(p1, 1.0)));
  w2 = vec3(dot(r0, vec4(p2, 1.0)), dot(r1, vec4(p2, 1.0)), dot(r2, vec4(p2, 1.0)));
}

// Solid-angle pdf of the light table picking direction onto triangle `tri` of `li` at
// distance `t` along `dir` (for MIS against BRDF sampling). 0 when degenerate.
float lightTrianglePdf(LightInstance li, const uint tri, const float p_pick, const float t, const vec3 dir) {
  uint g;
  vec3 w0, w1, w2;
  lightTriangleWorld(li, tri, g, w0, w1, w2);
  const vec3 lng = cross(w1 - w0, w2 - w0);
  const float area2 = length(lng);
  if (area2 <= 0.0) { return 0.0; }
  const float cos_l = abs(dot(lng / area2, dir));
  if (cos_l <= 1.0e-4) { return 0.0; }
  return p_pick * t * t / (cos_l * 0.5 * area2);
}

// ---- Radiance cache (SHaRC-style; see src/sharc.rs) ---------------------------------------

// Must match SHARC_ENTRIES in src/sharc.rs.
const uint SHARC_ENTRIES = 1u << 20;

// Voxel key: position quantized at a distance-scaled size, level, dominant face normal.
uvec4 sharcKey(const vec3 pos, const vec3 n, const vec3 cam) {
  const float d = max(length(pos - cam), 1.0e-3);
  const float level = floor(log2(max(d / 8.0, 1.0)));
  const float s = max(pc.uniforms.sharc_voxel, 1.0e-3) * exp2(level);
  const ivec3 c = ivec3(floor(pos / s));
  uint axis = abs(n.x) > abs(n.y) ? (abs(n.x) > abs(n.z) ? 0u : 2u)
                                  : (abs(n.y) > abs(n.z) ? 1u : 2u);
  axis = axis * 2u + (n[axis] < 0.0 ? 1u : 0u);
  return uvec4(uint(c.x), uint(c.y), uint(c.z), (uint(level) << 3) | axis);
}

uint sharcHash(const uvec4 k) {
  uint h = k.x * 0x8da6b343u ^ k.y * 0xd8163841u ^ k.z * 0xcb1ab31fu ^ k.w * 0x165667b1u;
  h ^= h >> 16; h *= 0x7feb352du; h ^= h >> 15; h *= 0x846ca68bu; h ^= h >> 16;
  return h;
}

// Find-or-insert the entry for a voxel key: linear probe with a tag compare, claiming an
// empty slot atomically. Returns ~0 when the neighbourhood is full (the path just traces on).
uint sharcSlot(const vec3 pos, const vec3 n, const vec3 cam) {
  const uvec4 key = sharcKey(pos, n, cam);
  const uint h = sharcHash(key);
  const uint tag = (sharcHash(key.wxyz) | 1u);
  for (uint i = 0u; i < 8u; i++) {
    const uint slot = (h + i) & (SHARC_ENTRIES - 1u);
    const uint t = pc.sharc.data[slot].tag;
    if (t == tag) { return slot; }
    if (t == 0u) {
      const uint prev = atomicCompSwap(pc.sharc.data[slot].tag, 0u, tag);
      if (prev == 0u || prev == tag) { return slot; }
    }
  }
  return 0xFFFFFFFFu;
}

// The resolved radiance, if the entry has folded in enough samples to be trusted.
bool sharcQuery(const uint slot, out vec3 radiance) {
  const vec2 rg = unpackHalf2x16(pc.sharc.data[slot].res_rg);
  const vec2 bc = unpackHalf2x16(pc.sharc.data[slot].res_bc);
  radiance = vec3(rg, bc.x);
  return bc.y >= 8.0;
}

// One path sample of the voxel's outgoing radiance (nits, fixed point at 1 nit).
void sharcDeposit(const uint slot, const vec3 radiance) {
  const vec3 r = clamp(radiance, vec3(0.0), vec3(1.0e6));
  atomicAdd(pc.sharc.data[slot].acc_r, uint(r.r));
  atomicAdd(pc.sharc.data[slot].acc_g, uint(r.g));
  atomicAdd(pc.sharc.data[slot].acc_b, uint(r.b));
  atomicAdd(pc.sharc.data[slot].acc_n, 1u);
  pc.sharc.data[slot].frame = pc.uniforms.frame;
}

// Entry from the power CDF at cumulative value x, and its pick probability.
uint lightsPickEntry(const float x, out float p_pick) {
  uint lo = 0u, hi = pc.lights.entry_count - 1u;
  while (lo < hi) {
    const uint mid = (lo + hi) / 2u;
    if (pc.lights.cdf.data[mid] < x) { lo = mid + 1u; } else { hi = mid; }
  }
  p_pick = (pc.lights.cdf.data[lo] - (lo > 0u ? pc.lights.cdf.data[lo - 1u] : 0.0)) / pc.lights.total_power;
  return lo;
}

// The light instance owning entry e (greatest entry_base <= e).
uint lightsFindInstance(const uint e) {
  uint lo = 0u, hi = pc.lights.linst_count - 1u;
  while (lo < hi) {
    const uint mid = (lo + hi + 1u) / 2u;
    if (pc.lights.linsts.data[mid].entry_base <= e) { lo = mid; } else { hi = mid - 1u; }
  }
  return lo;
}

// Unshadowed contribution of the point (su, sv) on light-table entry `e`, in AREA measure:
// f * NoL * Le * cos_l / d^2, evaluated at shading point `sp` (normal n, geometric normal
// ns, view v). Outputs the area pdf (p_pick / live area), the matching solid-angle pdf and
// the shadow-ray direction / distance; returns 0 on any rejection.
vec3 lightSampleEval(const uint e, const uint li_idx, const float p_pick,
                     const float su, const float sv,
                     const vec3 sp, const vec3 n, const vec3 ns, const vec3 v,
                     const DisneyMaterial mat,
                     out float p_area, out float pdf_solid, out vec3 dir, out float dist) {
  p_area = 0.0;
  pdf_solid = 0.0;
  dir = vec3(0.0);
  dist = 0.0;
  LightInstance li = pc.lights.linsts.data[li_idx];
  uint g;
  vec3 w0, w1, w2;
  lightTriangleWorld(li, e - li.entry_base, g, w0, w1, w2);
  const vec3 lng = cross(w1 - w0, w2 - w0);
  const float area2 = length(lng);
  if (area2 <= 0.0) { return vec3(0.0); }
  const float r = sqrt(max(su, 1.0e-6));
  const vec3 point = w0 * (1.0 - r) + w1 * (r * (1.0 - sv)) + w2 * (r * sv);
  const vec3 to_light = point - sp;
  dist = length(to_light);
  if (dist <= 1.0e-4) { return vec3(0.0); }
  dir = to_light / dist;
  const float cos_l = abs(dot(lng / area2, dir));
  const float NoL = dot(n, dir);
  if (cos_l <= 1.0e-4 || NoL <= 0.0 || dot(dir, ns) <= 0.0) { return vec3(0.0); }
  const vec3 f = evalDisneyBRDF(v, n, dir, mat);
  p_area = p_pick / (0.5 * area2);
  pdf_solid = p_area * dist * dist / cos_l;
  const vec3 emission = vec3(li.geom_emission.data[g * 3u + 0u],
                             li.geom_emission.data[g * 3u + 1u],
                             li.geom_emission.data[g * 3u + 2u]);
  return f * NoL * emission * (cos_l / (dist * dist));
}

void main() {
  // Under DLSS every frame needs fresh noise for the temporal denoiser; `tick` is the
  // accumulation counter and sits at 0 while accumulation is off.
  initRandom(gl_LaunchSizeEXT.xy, gl_LaunchIDEXT.xy, pc.uniforms.dlss != 0 ? pc.uniforms.frame : pc.uniforms.tick);

  const ivec2 px = ivec2(gl_LaunchIDEXT.xy);
  const bool dlss = pc.uniforms.dlss != 0;

  // wide screen
  if (float(gl_LaunchIDEXT.y) < gl_LaunchSizeEXT.y * 0.1 || float(gl_LaunchIDEXT.y) > gl_LaunchSizeEXT.y * 0.9) {
    if (dlss) {
      imageStore(dlss_color, px, vec4(0.0, 0.0, 0.0, 1.0));
      imageStore(guide_normal_roughness, px, vec4(0.0, 0.0, 0.0, 1.0));
      imageStore(guide_diffuse, px, vec4(0.0));
      imageStore(guide_specular, px, vec4(0.0));
      imageStore(guide_depth, px, vec4(0.0));
      imageStore(guide_spec_hit, px, vec4(0.0));
      imageStore(guide_motion, px, vec4(0.0));
    } else {
      imageStore(render_target, px, vec4(0.0));
    }
    return;
  }

  const float tmin = 0.0001;
  const float tmax = 1000.0;

  // DLSS: a known sub-pixel jitter (told to NGX) instead of the random one; the launch
  // y is flipped into the NDC-up space here, so the image-space offset is +jitter.
  const vec2 subpixel = dlss ? vec2(0.5 + pc.uniforms.jitter.x, 0.5 - pc.uniforms.jitter.y) : vec2(randf(), randf());
  const vec2 pixel_center = vec2(gl_LaunchIDEXT.x, gl_LaunchSizeEXT.y - gl_LaunchIDEXT.y) + subpixel;
  const vec2 inUV = pixel_center / vec2(gl_LaunchSizeEXT.xy);
  const vec2 d = inUV * 2.0 - 1.0;


  const vec3 initial_origin = (pc.uniforms.inverse_view * vec4(0,0,0,1)).xyz;
  const vec3 target = (pc.uniforms.inverse_projection * vec4(d, 1, 1)).xyz;
  const vec3 initial_direction = (pc.uniforms.inverse_view * vec4(normalize(target), 0)).xyz;
  const vec3 focalPoint = initial_origin + initial_direction * pc.focus.focal_distance;

  if (pc.uniforms.pull_focus_x == gl_LaunchIDEXT.x && pc.uniforms.pull_focus_y == gl_LaunchIDEXT.y) {
    traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, initial_origin, tmin, initial_direction, tmax, 0);
    if (payload.t != 0.0) {
      pc.focus.focal_distance = payload.t;
    }
  }

  vec3 acc = vec3(0.0);
  const uint SAMPLES = pc.uniforms.samples;
  const uint MAX_BOUNCES = pc.uniforms.max_bounces;

  for (uint sample_idx = 0; sample_idx < SAMPLES; sample_idx += 1) {
    const float offsetR = sqrt(randf());
    const float offsetA = randf() * 2.0f * PI;
    const vec2 offset = pc.uniforms.aperture * vec2(offsetR * cos(offsetA), offsetR * sin(offsetA));

    vec3 origin = (pc.uniforms.inverse_view * vec4(offset, 0, 1)).xyz;
    vec3 direction = normalize(focalPoint - origin);
    vec3 mask = vec3(1.0);
    // The camera ray and pure-specular continuations may see the sun disc directly; after a
    // BRDF-sampled bounce the sun comes from next-event estimation only.
    bool want_sun = true;
    // Solid-angle pdf of the ray being traced, when it came from BRDF sampling (0 for the
    // camera ray and delta continuations): the MIS partner of light-table sampling.
    float prev_pdf = 0.0;
    // Radiance-cache update targets along this path: the voxel and, per vertex, snapshots
    // of the running mask / radiance so the vertex's outgoing radiance falls out as a delta
    // once the path ends.
    uint sh_slot[4];
    vec3 sh_mask[4];
    vec3 sh_acc[4];
    uint sh_n = 0u;

    for (uint bounce_idx = 0; bounce_idx < MAX_BOUNCES; bounce_idx += 1) {
      payload.want_sun = want_sun ? 1u : 0u;
      traceRayEXT(topLevelAS, gl_RayFlagsOpaqueEXT, 0xFF, 0, 0, 0, origin, tmin, direction, tmax, 0);

      const vec3 surface_normal = oct_to_float32x3(payload.surface_and_world_normal.xy);
      const vec3 world_normal = oct_to_float32x3(payload.surface_and_world_normal.zw);

      // DLSS guides from sample 0's primary hit; the specular hit distance from its next hit.
      if (dlss && sample_idx == 0) {
        if (bounce_idx == 0) {
          if (payload.t == 0.0) {
            imageStore(guide_normal_roughness, px, vec4(0.0, 0.0, 0.0, 1.0));
            imageStore(guide_diffuse, px, vec4(0.0));
            imageStore(guide_specular, px, vec4(0.0));
            imageStore(guide_depth, px, vec4(0.0));
            imageStore(guide_motion, px, vec4(0.0));
            imageStore(guide_spec_hit, px, vec4(0.0));
          } else {
            const float g_roughness = hitPayloadGetRoughness(payload);
            const float g_metallic = hitPayloadGetMetallic(payload);
            const vec3 hit_pos = origin + direction * payload.t;
            const vec4 view_pos = pc.uniforms.view * vec4(hit_pos, 1.0);
            const float linear_depth = max(-view_pos.z, 1.0e-4);
            const vec3 albedo = clamp(payload.color.rgb, vec3(0.0), vec3(1.0));
            // Ray Reconstruction wants LINEAR roughness; the material's is perceptual.
            const float linear_roughness = clamp(g_roughness * g_roughness, 0.0, 1.0);
            imageStore(guide_normal_roughness, px, vec4(world_normal, linear_roughness));
            imageStore(guide_diffuse, px, vec4(albedo * (1.0 - g_metallic), 1.0));
            imageStore(guide_specular, px, vec4(mix(vec3(0.04), albedo, g_metallic), 1.0));
            imageStore(guide_depth, px, vec4(min(linear_depth, 1.0e7), 0.0, 0.0, 0.0));
            // Motion in UV units (y down), current minus previous; NGX scales by -(w,h).
            const vec4 cur_clip = pc.uniforms.view_proj * vec4(hit_pos, 1.0);
            const vec4 prev_clip = pc.uniforms.prev_view_proj * vec4(payload.prev_world_pos, 1.0);
            vec2 motion = vec2(0.0);
            if (cur_clip.w > 1.0e-4 && prev_clip.w > 1.0e-4) {
              const vec2 cur_uv = (cur_clip.xy / cur_clip.w) * vec2(0.5, -0.5);
              const vec2 prev_uv = (prev_clip.xy / prev_clip.w) * vec2(0.5, -0.5);
              motion = clamp(cur_uv - prev_uv, vec2(-2.0), vec2(2.0));
            }
            imageStore(guide_motion, px, vec4(motion, 0.0, 0.0));
            imageStore(guide_spec_hit, px, vec4(0.0));
          }
        } else if (bounce_idx == 1) {
          imageStore(guide_spec_hit, px, vec4(min(payload.t, 1.0e7), 0.0, 0.0, 0.0));
        }
      }
      const float roughness = hitPayloadGetRoughness(payload);
      const float metallic = hitPayloadGetMetallic(payload);
      const float transmission = hitPayloadGetTransmission(payload);
      const bool inside = hitPayloadGetInside(payload);

      // fog bounce (skybox has a distance of 0 so will never hit
      // this case, having an extra check for this is slower than
      // deferring to the generic emitter check)
      const float fogDistance = sampleDistanceInFog();
      if (fogDistance < payload.t) {
        origin = origin + direction * fogDistance;
        mask *= calcFogTransmittance(fogDistance);
        direction = sampleFogScatterDirection(direction);
        prev_pdf = 0.0;
        continue;
      }

      // hit an emitter
      if (payload.emission != vec3(0.0) || payload.t == 0.0) {
        vec3 contribution = mask * payload.emission;
        // MIS: a BRDF-sampled ray landing on a table light shares credit with the
        // next-event estimate taken at the previous vertex (prev_pdf 0 = camera ray or
        // delta continuation, which take the emission at full weight).
        if (payload.t != 0.0 && prev_pdf > 0.0 && pc.uniforms.light_entries > 0u
            && payload.slot < pc.lights.slot_map_count && pc.lights.total_power > 0.0) {
          const uint linst_idx = pc.lights.slot_to_linst.data[payload.slot];
          if (linst_idx != 0xFFFFFFFFu) {
            LightInstance li = pc.lights.linsts.data[linst_idx];
            if (payload.prim_tri < li.tri_count) {
              const uint e = li.entry_base + payload.prim_tri;
              const float p_pick = (pc.lights.cdf.data[e] - (e > 0u ? pc.lights.cdf.data[e - 1u] : 0.0))
                                   / pc.lights.total_power;
              if (p_pick > 0.0) {
                const float pdf_light = lightTrianglePdf(li, payload.prim_tri, p_pick, payload.t, direction);
                if (pdf_light > 0.0) {
                  contribution *= prev_pdf / (prev_pdf + pdf_light);
                }
              }
            }
          }
        }
        // Firefly suppression: an indirect path that reaches an emitter far brighter than the
        // sky would take hundreds of frames to average out; clamp its luminance instead.
        if (bounce_idx > 0 && pc.uniforms.radiance_clamp > 0.0) {
          contribution *= min(1.0, pc.uniforms.radiance_clamp / max(luma(contribution), 1.0e-6));
        }
        acc += contribution;
        break;
      }

      // semi translucent textures
      origin = origin + direction * payload.t;
      if (payload.color.a < 1.0 && randf() < 1-payload.color.a) { continue; }
      // pure black textures are often used as translucent masks.
      if (payload.color.rgb == vec3(0.0)) { continue; }

      // refraction (glass)
      if (randf() < transmission) {
        // calculate the eta based on whether we are inside
        const float n1 = inside ? payload.refract_index : 1.0f;
        const float n2 = inside ? 1.0f : payload.refract_index;
        const float eta = n1 / n2;

        const float costi = dot(world_normal, -direction);
        const float k = 1 - (eta* eta) * (1 - costi * costi);


        float pReflect;
        if (k < 0) {
            // Total internal reflection
            pReflect = 1;
        } else {
            // fresnell equation for reflection contribution
            const float sinti = sqrt(max(0.0f, 1.0f - costi - costi));
            const float costt = sqrt(1.0f - eta * eta * sinti * sinti);
            const float spol = (n1 * costi - n2 * costt) / (n1 * costi + n2 * costt);
            const float ppol = (n1 * costt - n2 * costi) / (n1 * costt + n2 * costi);
            pReflect = 0.5f * (spol * spol + ppol * ppol);
        }

        vec3 refract_dir;
        if (randf() <= pReflect) {
            refract_dir = reflect(direction, world_normal);
        } else {
            refract_dir = normalize(eta * direction + world_normal * (eta * costi - sqrt(k)));
        }

        const mat3 basis = orthonormalBasis(world_normal);
        const vec3 sample_dir = basis * CosineSampleHemisphere(randf(), randf());
        direction = mix(refract_dir, sample_dir, roughness);
        if (inside) {
          mask *= exp(-payload.t * payload.absorption);
        }
        prev_pdf = 0.0;
        continue;
      }

      // russian roullete
      // stopping on the first two bounces is a waste because we haven't been able
      // to gather much light yet except those directly in view of the camera, but
      // those paths would be terminated there and then anyway because they hit
      // an emitter.
      if (bounce_idx > 1) {
        const float pRussian = clamp(luma(payload.color.rgb), 0.03, 0.9);
        if (randf() >= pRussian) { break; }
        mask /= pRussian;
      }

      const DisneyMaterial disney_mat = DisneyMaterial(
        payload.color.rgb, metallic, roughness
      );

      // Radiance cache: diffuse-ish vertices past the primary hit take part. From bounce
      // 2 on, a converged voxel ends the path with its cached outgoing radiance; every
      // participating vertex is also recorded as an update target, so the cache keeps
      // learning from the paths that do get traced (including ones that end in a query).
      if (pc.uniforms.sharc != 0u && bounce_idx > 0
          && roughness >= 0.35 && metallic <= 0.5 && transmission < 0.01) {
        const uint slot = sharcSlot(origin, world_normal, initial_origin);
        if (slot != 0xFFFFFFFFu) {
          if (bounce_idx >= 2) {
            vec3 cached;
            if (sharcQuery(slot, cached)) {
              acc += mask * cached;
              break;
            }
          }
          if (sh_n < 4u) {
            sh_slot[sh_n] = slot;
            sh_mask[sh_n] = mask;
            sh_acc[sh_n] = acc;
            sh_n++;
          }
        }
      }

      // Direct light from the emissive-triangle table. At the primary vertex of sample 0
      // this is ReSTIR DI (RIS over the CDF candidates, temporal reservoir reuse across
      // the reprojected pixel, one visibility ray whose occlusion also clears the stored
      // weight); everywhere else it is one CDF sample with an MIS-weighted shadow ray.
      // Positions and areas are read live, so stale CDF weights change variance, never
      // the answer.
      if (pc.uniforms.light_entries > 0u && pc.lights.total_power > 0.0) {
        if (bounce_idx == 0 && sample_idx == 0 && pc.uniforms.restir_candidates > 0u) {
          uint r_y = 0u;
          uint r_uv = 0u;
          float r_wsum = 0.0;
          float r_M = 0.0;
          float r_phat = 0.0;
          vec3 r_val = vec3(0.0);
          vec3 r_dir = vec3(0.0);
          float r_dist = 0.0;
          // Initial candidates.
          for (uint c = 0u; c < pc.uniforms.restir_candidates; c++) {
            float p_pick;
            const uint e = lightsPickEntry(randf() * pc.lights.total_power, p_pick);
            const float su = randf();
            const float sv = randf();
            float p_area, pdf_solid, cdist;
            vec3 cdir;
            const vec3 val = lightSampleEval(e, lightsFindInstance(e), p_pick, su, sv,
                                             origin, world_normal, surface_normal,
                                             -direction, disney_mat,
                                             p_area, pdf_solid, cdir, cdist);
            r_M += 1.0;
            const float phat = luma(val);
            if (phat > 0.0 && p_area > 0.0) {
              const float wi = phat / p_area;
              r_wsum += wi;
              if (randf() * r_wsum < wi) {
                r_y = e;
                r_uv = packHalf2x16(vec2(su, sv));
                r_phat = phat;
                r_val = val;
                r_dir = cdir;
                r_dist = cdist;
              }
            }
          }
          // Temporal reuse: last frame's reservoir at the reprojected pixel, revalidated
          // and re-evaluated at this frame's shading point.
          const vec4 prev_clip = pc.uniforms.prev_view_proj * vec4(payload.prev_world_pos, 1.0);
          if (prev_clip.w > 1.0e-4) {
            const vec2 uv01 = (prev_clip.xy / prev_clip.w) * 0.5 + 0.5;
            const ivec2 ppx = ivec2(uv01.x * float(gl_LaunchSizeEXT.x),
                                    float(gl_LaunchSizeEXT.y) - uv01.y * float(gl_LaunchSizeEXT.y));
            if (ppx.x >= 0 && ppx.y >= 0
                && ppx.x < int(gl_LaunchSizeEXT.x) && ppx.y < int(gl_LaunchSizeEXT.y)) {
              const Reservoir prev = pc.reservoirs_prev.data[ppx.y * int(gl_LaunchSizeEXT.x) + ppx.x];
              if (prev.frame + 1u == pc.uniforms.frame
                  && prev.epoch == pc.uniforms.light_epoch
                  && prev.M > 0.0 && prev.W > 0.0
                  && abs(prev.depth - prev_clip.w) < 0.1 * prev_clip.w
                  && dot(oct_to_float32x3(unpackHalf2x16(prev.normal_pk)), world_normal) > 0.9) {
                const vec2 suv = unpackHalf2x16(prev.uv_pk);
                float p_area_ign, pdf_solid_ign, cdist;
                vec3 cdir;
                const vec3 val = lightSampleEval(prev.y, lightsFindInstance(prev.y), 1.0,
                                                 suv.x, suv.y, origin, world_normal,
                                                 surface_normal, -direction, disney_mat,
                                                 p_area_ign, pdf_solid_ign, cdir, cdist);
                const float phat = luma(val);
                const float Mprev = min(prev.M, pc.uniforms.restir_m_clamp);
                if (phat > 0.0) {
                  const float wi = phat * prev.W * Mprev;
                  r_wsum += wi;
                  if (randf() * r_wsum < wi) {
                    r_y = prev.y;
                    r_uv = prev.uv_pk;
                    r_phat = phat;
                    r_val = val;
                    r_dir = cdir;
                    r_dist = cdist;
                  }
                }
                r_M += Mprev;
              }
            }
          }
          // Resolve: contribution weight, one visibility ray, shade.
          float r_W = (r_phat > 0.0 && r_M > 0.0) ? r_wsum / (r_M * r_phat) : 0.0;
          if (r_W > 0.0) {
            payload.t = -1.0;
            traceRayEXT(topLevelAS,
                        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        0xFF, 0, 0, 0, origin, tmin, r_dir, r_dist - 2.0 * tmin, 0);
            if (payload.t == 0.0) {
              acc += mask * r_val * r_W;
            } else {
              // Visibility reuse: an occluded winner is forgotten, not dragged along.
              r_W = 0.0;
            }
          }
          Reservoir cur;
          cur.y = r_y;
          cur.uv_pk = r_uv;
          cur.W = r_W;
          cur.M = min(r_M, pc.uniforms.restir_m_clamp);
          cur.epoch = pc.uniforms.light_epoch;
          cur.normal_pk = packHalf2x16(float32x3_to_oct(world_normal));
          const vec4 cur_clip = pc.uniforms.view_proj * vec4(origin, 1.0);
          cur.depth = cur_clip.w;
          cur.frame = pc.uniforms.frame;
          pc.reservoirs_cur.data[px.y * int(gl_LaunchSizeEXT.x) + px.x] = cur;
        } else {
          float p_pick;
          const uint e = lightsPickEntry(randf() * pc.lights.total_power, p_pick);
          float p_area, pdf_solid, ldist;
          vec3 ldir;
          const vec3 val = lightSampleEval(e, lightsFindInstance(e), p_pick, randf(), randf(),
                                           origin, world_normal, surface_normal, -direction,
                                           disney_mat, p_area, pdf_solid, ldir, ldist);
          if (luma(val) > 0.0 && p_area > 0.0) {
            const float w = pdf_solid / (pdf_solid + pdfDisneyBRDF(-direction, world_normal, ldir, disney_mat));
            payload.t = -1.0;
            traceRayEXT(topLevelAS,
                        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        0xFF, 0, 0, 0, origin, tmin, ldir, ldist - 2.0 * tmin, 0);
            if (payload.t == 0.0) {
              vec3 contribution = mask * val * (w / p_area);
              if (bounce_idx > 0 && pc.uniforms.radiance_clamp > 0.0) {
                contribution *= min(1.0, pc.uniforms.radiance_clamp / max(luma(contribution), 1.0e-6));
              }
              acc += contribution;
            }
          }
        }
      }

      // Next-event estimation for the procedural sun: one shadow ray towards a uniformly
      // sampled point on the disc. Direct sunlight is the dominant, low-variance term, so it
      // is not firefly-clamped; BRDF-sampled rays that reach the disc afterwards return the
      // sky only (`want_sun` = 0), so nothing is counted twice.
      if (pc.uniforms.sky_mode == 2u && pc.uniforms.sun_radiance.r > 0.0) {
        const vec3 l = sampleCone(pc.uniforms.sun_direction, pc.uniforms.sun_cos_radius, randf(), randf());
        const float NoL = dot(world_normal, l);
        if (NoL > 0.0 && dot(l, surface_normal) > 0.0) {
          const vec3 f = evalDisneyBRDF(-direction, world_normal, l, disney_mat);
          if (any(greaterThan(f, vec3(0.0)))) {
            // Shadow ray: any accepted hit terminates without running a closest-hit
            // shader, so the payload's t only becomes 0 when the miss shader ran. Not
            // opaque-forced: the any-hit shader lets it through alpha-masked cutouts.
            payload.t = -1.0;
            traceRayEXT(topLevelAS,
                        gl_RayFlagsTerminateOnFirstHitEXT | gl_RayFlagsSkipClosestHitShaderEXT,
                        0xFF, 0, 0, 0, origin, tmin, l, tmax, 0);
            if (payload.t == 0.0) {
              const float solid_angle = 2.0 * PI * (1.0 - pc.uniforms.sun_cos_radius);
              acc += mask * f * NoL * pc.uniforms.sun_radiance * solid_angle;
            }
          }
        }
      }

      vec4 noise;
      if (ENABLE_BLUENOISE && bounce_idx == 0) {
        vec2 bnoise = bnoiseBest(sample_idx);
        // bluenoise sampling on the first bounce, since the noise values
        // are used mostly exlusively, we'll copy them for both specular
        // and diffuse input. That way consective samples are also properly
        // blue.
        noise = vec4(bnoise, bnoise);
      } else {
        noise = vec4(randf(), randf(), randf(), randf());
      }

      // stratified sampling on the second bounce
      // doing it on multiple bounces like this is invalid because
      // they will become correlated.
      // This also increases raytracing performances because
      // the rays are more uniform, increasing coherence of memory
      // accesses! (effect is about 1% on fps @3 spp)
      if (bounce_idx == 0) {
        noise.x = noise.x / SAMPLES + sample_idx / float(SAMPLES);
        noise.z = noise.z / SAMPLES + sample_idx / float(SAMPLES);
      }

      const vec4 brdf = sampleDisneyBRDF(noise, -direction, world_normal, disney_mat, direction);
      want_sun = false;
      // brdf.a is the lobe-weighted solid-angle pdf; ~0 marks a pure specular (delta) bounce.
      prev_pdf = brdf.a > 0.0001 ? brdf.a : 0.0;

      // Prevent going into the surface (leaks light through walls)
      if (dot(direction, surface_normal) < 0) { break; }

      // Note that an 'a' value of 0 does not mean that the bounce is impossible, but rather
      // that the bounce is a pure specular bounce.
      if (brdf.a > 0.0001) {
        mask *= brdf.rgb / brdf.a;
      }
    }

    // The path ended: everything gathered after each cache vertex, divided by its mask
    // snapshot, is one sample of that voxel's outgoing radiance (zero radiance included --
    // darkness is learned too).
    for (uint si = 0u; si < sh_n; si++) {
      const vec3 delta = max(acc - sh_acc[si], vec3(0.0));
      const vec3 m = sh_mask[si];
      sharcDeposit(sh_slot[si], vec3(
        m.r > 1.0e-6 ? delta.r / m.r : 0.0,
        m.g > 1.0e-6 ? delta.g / m.g : 0.0,
        m.b > 1.0e-6 ? delta.b / m.b : 0.0));
    }
  }


  if (dlss) {
    // Ray Reconstruction takes PRE-EXPOSED linear HDR (it has no exposure handling of its
    // own -- RR guide 3.7), so the camera exposure is applied here and the blit skips it for
    // this path. Finite and inside f16 range.
    const vec3 radiance = clamp(acc / SAMPLES * pc.uniforms.exposure, vec3(0.0), vec3(65504.0));
    imageStore(dlss_color, px, vec4(radiance, 1.0));
    return;
  }
  vec4 prev = imageLoad(render_target, px);
  if (pc.uniforms.accumulate == 0) { prev = vec4(0); }
  imageStore(render_target, px, vec4(acc / SAMPLES, 1) + prev);
}

